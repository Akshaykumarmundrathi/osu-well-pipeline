# ── Never copy into the image ──────────────────────────────────────────────
.env
.env.*
!.env.example

# Credentials / secrets
credentials/
*.pem
*.key
*.p12
smiling-breaker*.json

# Git / IDE
.git/
.gitignore
.github/
.vscode/
.idea/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Local data / outputs (large — never in image)
project_outputs*/
project_outputs_cloud/
smoke_test_output/
outputs_1911/
pdfs/
*.zip
*.tar.gz

# Docs site (served from GitHub Pages, not needed in container)
docs/

# Test / QA artifacts
inspect_grids.py
run_1911.py
*.csv
!requirements.txt

# Windows-specific
Thumbs.db
desktop.ini

# macOS
.DS_Store

# Build artifacts
dist/
build/
*.egg-info/

# Large model files are INCLUDED (unet_best.pth is needed at runtime)
# If you have other large .pth files, add them here:
# other_model.pth
