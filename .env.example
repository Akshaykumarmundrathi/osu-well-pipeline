# ============================================================
# OSU Well Records Pipeline — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- RDS (PostgreSQL PLSS database) ----
RDS_HOST=your-rds-endpoint.rds.amazonaws.com
RDS_PORT=5432
RDS_DBNAME=Oklahomaplss
RDS_USER=LookUpMaster
RDS_PASSWORD=your-password-here

# ---- Google Cloud (Vision OCR + Gemini) ----
# Path to GCP service-account JSON (local dev only).
# In Docker/Batch, injected from Secrets Manager by run_batch_job.py.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials/service-account.json
GOOGLE_API_KEY=your-gemini-api-key-here

# ---- AWS ----
AWS_DEFAULT_REGION=us-east-1
# Leave blank to use the IAM role attached to EC2 / Batch container.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Secrets Manager (Batch jobs only) ----
# GCP secret: {"gcp_service_account": {...}, "gemini_api_key": "..."}
GOOGLE_CREDS_SECRET_ID=osu-pipeline/credentials
# RDS secret: {"RDS_HOST": "...", "RDS_DBNAME": "...", "RDS_USER": "...", "RDS_PASSWORD": "..."}
RDS_CREDS_SECRET_ID=osu-pipeline/rds

# ---- U-Net checkpoint ----
UNET_CHECKPOINT=/app/unet_best.pth

# ---- Pipeline output root ----
# Local dev: absolute path.  Docker: /tmp/output (set automatically by run_batch_job.py).
# Windows example: D:\project_outputs   Linux/Mac example: /home/user/project_outputs
OUTPUT_ROOT=/path/to/project_outputs

# ---- Source repo root (used by build_map_data.py to find docs/) ----
# Windows example: D:\project_modular   Linux/Mac: /home/user/project_modular
REPO_ROOT=/path/to/project_modular

# ---- Pipeline source code root (used by run_coord_enrichment.py) ----
# Windows example: D:\project_modular\project
D_PROJECT_ROOT=/path/to/project_modular/project

# ---- Smoke test output dir ----
SMOKE_ROOT=/tmp/smoke_test

# ---- Gemini models (free tier) ----
GEMINI_FLASH_MODEL=gemini-2.0-flash-lite
GEMINI_PRO_MODEL=gemini-2.0-flash-lite

# ---- Collection source base dir (used by smoke_test.py) ----
# Parent directory that contains ExportedFolderContents (N) folders.
# Windows: D:\   Linux/Mac: /mnt/data
COLLECTION_BASE=D:\

# ---- Source ZIP root (used by scan_dataset.py + main.py on local runs) ----
# Windows: D:\   Linux/Mac: /mnt/data
SOURCE_ROOT=D:\

# ---- S3 URL base (used by build_map_data.py for PDF viewer links) ----
S3_BUCKET=osu-well-records-225989338968
S3_REGION=us-east-1

# ---- Vision API toggle (set to 0 to skip Cloud Vision, use Tesseract only) ----
# USE_VISION_API=1

# ---- Optional tuning (all have safe defaults — only set if needed) ----
# GEMINI_MIN_CALL_GAP_S=2.0    # minimum seconds between Gemini API calls
# GRID_PAGE_TIMEOUT_S=120      # max seconds allowed for grid detection per page

# ---- AWS Batch / S3 (set at job-submission time, not here) ----
INPUT_BUCKET=osu-well-records-225989338968
OUTPUT_BUCKET=osu-pipeline-results-mano
INDEX_KEY=index/dataset_index.csv
SLICE_SIZE=200
WORKERS=4

# ---- GitHub repo for map build job (used by run_mapbuild_job.py) ----
# Format: github.com/ORG/REPO.git  (no https:// prefix — token is prepended)
GITHUB_REPO_URL=github.com/YOUR_ORG/osu-well-pipeline.git

# ---- AWS multi-account orchestration ----
# See aws/.env.account2.template for the full set of Account 1/2 variables.
# Needed by: aws/orchestrate_robust.py, aws/monitor.py, aws/collect_results.py
# ACCOUNT1_ID=225989338968
# ACCOUNT2_ID=266087050585
# ECR_IMAGE=<acct1>.dkr.ecr.us-east-1.amazonaws.com/osu-pipeline:v15-skip-anchor
# EXEC_ROLE_ARN=arn:aws:iam::<acct2>:role/osu-batch-execution-role
# TASK_ROLE_ARN=arn:aws:iam::<acct2>:role/osu-batch-task-role
# JOB_QUEUE=osu-pipeline-queue
# JOB_DEF_NAME=osu-pipeline-job
# LOG_GROUP=/aws/batch/osu-pipeline
