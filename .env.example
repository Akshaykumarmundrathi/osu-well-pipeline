# ============================================================
# OSU Well Records Pipeline — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- RDS (PostgreSQL PLSS database) ----
RDS_HOST=your-rds-endpoint.rds.amazonaws.com
RDS_PORT=5432
RDS_DBNAME=Oklahomaplss
RDS_USER=LookUpMaster
RDS_PASSWORD=your-password-here

# ---- Google Cloud (Vision OCR + Gemini) ----
# Path to GCP service-account JSON (local dev only).
# In Docker/Batch, injected from Secrets Manager by run_batch_job.py.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials/service-account.json
GOOGLE_API_KEY=your-gemini-api-key-here

# ---- AWS ----
AWS_DEFAULT_REGION=us-east-1
# Leave blank to use the IAM role attached to EC2 / Batch container.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Secrets Manager (Batch jobs only) ----
# GCP secret: {"gcp_service_account": {...}, "gemini_api_key": "..."}
GOOGLE_CREDS_SECRET_ID=osu-pipeline/credentials
# RDS secret: {"RDS_HOST": "...", "RDS_DBNAME": "...", "RDS_USER": "...", "RDS_PASSWORD": "..."}
RDS_CREDS_SECRET_ID=osu-pipeline/rds

# ---- U-Net checkpoint ----
UNET_CHECKPOINT=/app/unet_best.pth

# ---- Pipeline output root ----
# Local dev: absolute path.  Docker: /tmp/output (set by run_batch_job.py).
OUTPUT_ROOT=D:\project_outputs

# ---- AWS Batch / S3 (set at job-submission time, not here) ----
INPUT_BUCKET=osu-well-records-225989338968
OUTPUT_BUCKET=osu-well-records-225989338968
INDEX_KEY=index/dataset_index.csv
SLICE_SIZE=1000
WORKERS=8
