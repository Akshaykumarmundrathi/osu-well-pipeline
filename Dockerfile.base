## ============================================================
## Stage: base  (heavy deps — rebuilt ONLY when requirements.txt
##               or the torch version changes)
##
## Build & push once:
##   docker build -f Dockerfile.base -t osu-pipeline-base .
##   docker tag osu-pipeline-base:latest \
##     225989338968.dkr.ecr.us-east-1.amazonaws.com/osu-pipeline-base:latest
##   docker push 225989338968.dkr.ecr.us-east-1.amazonaws.com/osu-pipeline-base:latest
##
## App image (Dockerfile) references this via FROM.
## Pip is split into 4 small layers to avoid Docker daemon OOM on commit.
## ============================================================
FROM python:3.11-slim

LABEL org.opencontainers.image.title="osu-well-pipeline-base" \
      org.opencontainers.image.description="Heavy deps layer: apt + pip + torch (rebuilt rarely)"

# OpenCV + PyMuPDF native libs + Tesseract
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 ca-certificates \
        tesseract-ocr tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/*

# ── pip layer 1: AWS + DB (~small, fast) ──────────────────────────────────
RUN pip install --no-cache-dir \
        boto3>=1.35 \
        psycopg2-binary>=2.9

# ── pip layer 2: Google APIs (pinned versions) ────────────────────────────
RUN pip install --no-cache-dir \
        protobuf==5.29.4 \
        grpcio==1.67.1 \
        googleapis-common-protos==1.65.0 \
        google-cloud-vision==3.7.4 \
        google-generativeai==0.8.3

# ── pip layer 3: PDF + image processing (~medium) ─────────────────────────
RUN pip install --no-cache-dir \
        pymupdf>=1.24 \
        opencv-python-headless>=4.10 \
        pillow>=10.4

# ── pip layer 4: ML + data + OCR (~medium) ────────────────────────────────
RUN pip install --no-cache-dir \
        numpy>=1.26 \
        pandas>=2.0 \
        rapidfuzz>=3.10 \
        matplotlib>=3.7 \
        scipy>=1.11 \
        pytesseract>=0.3.10

# ── pip layer 5: PyTorch CPU-only (~800 MB, own index) ────────────────────
RUN pip install --no-cache-dir \
        torch==2.4.1 torchvision==0.19.1 \
        --index-url https://download.pytorch.org/whl/cpu

# Encoding + runtime defaults (inherited by app image)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    AWS_DEFAULT_REGION=us-east-1
